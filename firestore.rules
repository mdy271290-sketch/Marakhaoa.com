rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function isAdmin() {
      return signedIn() && request.auth.token.email_verified == true
        && request.auth.token.email == 'sabibirahmed9@gmail.com';
    }
    function ok() {
      return signedIn() && !exists(/databases/$(database)/documents/blocked/$(request.auth.uid));
    }
    // ব্যানার ও শিরোনাম: সবাই দেখবে, অ্যাডমিন বদলাবে
    match /config/{id} { allow read: if true; allow write: if isAdmin(); }
    // প্রচার-লিঙ্ক
    match /promos/{id} { allow read: if true; allow write: if isAdmin(); }
    // বাদ দেওয়া আইডি
    match /blocked/{id} { allow read, write: if isAdmin(); }
    // প্রোফাইল: লগ ইন করা সদস্যরা দেখবে; নিজেরটা নিজে বদলাবে; অ্যাডমিন সবটা
    match /profiles/{id} {
      allow read: if signedIn();
      allow create, update: if isAdmin() || (ok() && request.auth.uid == id && request.resource.data.uid == id);
      allow delete: if isAdmin() || (signedIn() && request.auth.uid == id);
    }
    // জন্ম নিবন্ধনসহ ব্যক্তিগত তথ্য: শুধু মালিক ও অ্যাডমিন
    match /private/{id} {
      allow read: if isAdmin() || (signedIn() && request.auth.uid == id);
      allow create, update: if isAdmin() || (ok() && request.auth.uid == id);
      allow delete: if isAdmin() || (signedIn() && request.auth.uid == id);
    }
    // সমাজের পোস্ট
    match /posts/{id} {
      allow read: if signedIn();
      allow create: if isAdmin() || (ok() && request.resource.data.uid == request.auth.uid);
      allow delete: if isAdmin() || (signedIn() && resource.data.uid == request.auth.uid);
    }
    // অ্যাডমিনের কাছে জমা দেওয়া লেখা/আর্ট
    match /submissions/{id} {
      allow create: if ok() && request.resource.data.uid == request.auth.uid;
      allow read: if isAdmin() || (signedIn() && resource.data.uid == request.auth.uid);
      allow update, delete: if isAdmin() || (signedIn() && resource.data.uid == request.auth.uid);
    }
  }
}
